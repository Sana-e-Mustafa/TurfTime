@model List<TurfTime.Web.Models.Turf>
@{
    ViewData["Title"] = "Owner";
}

<h3 class="my-4">Owner dashboard</h3>
<div class="d-flex justify-content-between mb-2">
    <h5>My turfs (@Model.Count)</h5>
    <a asp-action="Create" class="btn btn-success btn-sm">Add turf</a>
</div>
<div id="err" class="text-danger small mb-2"></div>
<table class="table table-striped">
    <thead><tr><th>Name</th><th>Sport</th><th>City</th><th>Price/hr</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr id="row-@t.Id">
                <td>@t.Name</td>
                <td>@t.Sport</td>
                <td>@t.City</td>
                <td>Rs @t.PricePerHour</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <button class="btn btn-sm btn-outline-danger btn-del" data-id="@t.Id">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $('.btn-del').click(function () {
            var id = $(this).data('id');
            if (!confirm('Delete this turf?')) return;
            $.ajax({
                url: '/Owner/Delete', type: 'POST', data: { id: id },
                success: function (r) {
                    if (r.success) $('#row-' + id).remove();
                    else $('#err').text(r.message);
                }
            });
        });
    </script>
}