@model List<TurfTime.Web.Models.Turf>
@{
    ViewData["Title"] = "Owner";
}

<h3 class="my-4">Owner dashboard</h3>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><h6>My turfs</h6><h2>@Model.Count</h2></div></div></div>
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><h6>Today's bookings</h6><h2>5</h2></div></div></div>
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><h6>Earnings (month)</h6><h2>Rs 85,000</h2></div></div></div>
</div>

<div class="d-flex justify-content-between mb-2">
    <h5>My turfs</h5>
    <button class="btn btn-success btn-sm">Add turf</button>
</div>
<table class="table table-striped">
    <thead><tr><th>Name</th><th>Sport</th><th>City</th><th>Price/hr</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Name</td>
                <td>@t.Sport</td>
                <td>@t.City</td>
                <td>Rs @t.PricePerHour</td>
                <td><button class="btn btn-sm btn-outline-primary">Edit</button> <button class="btn btn-sm btn-outline-danger">Delete</button></td>
            </tr>
        }
    </tbody>
</table>